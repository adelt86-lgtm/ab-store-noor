VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_DEFAULT_STORE_SLUG=noor
VITE_META_PIXEL_ID=

# Server-only: required for secure shipping credential storage / API calls.
# NEVER prefix this with VITE_ and NEVER expose it to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional shipping defaults
SHIPPING_FROM_WILAYA=16
YALIDINE_API_BASE=https://api.yalidine.app/v1
YALIDINE_FROM_WILAYA=Alger
MAYSTRO_API_BASE=https://backend.maystro-delivery.com/api
NOEST_API_BASE=https://app.noest-dz.com

# V3.2 Shipping Engine (server-side only; NEVER expose in VITE_ variables)
# Generate: openssl rand -base64 32
SHIPPING_CREDENTIALS_KEY=
# Exact public app origin, e.g. https://your-domain.vercel.app
APP_ORIGIN=
# Optional carrier API overrides
YALIDINE_API_BASE=https://api.yalidine.app/v1
YALIDINE_FROM_WILAYA=Alger
ZR_NEW_API_BASE=https://api.zrexpress.app
